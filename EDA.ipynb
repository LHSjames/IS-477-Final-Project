   ],
   "source": [
    "# Compute overall descriptive statistics for price and minimum nights.\n",
    "summary_cols = [x for x in [price_col, minn_col] if x is not None]\n",
    "summary = pd.DataFrame({\n",
    "    \"count\": df[summary_cols].count(),\n",
    "    \"mean\": df[summary_cols].mean(),\n",
    "    \"std\": df[summary_cols].std(),\n",
    "    \"min\": df[summary_cols].min(),\n",
    "    \"p50\": df[summary_cols].median(),\n",
    "    \"p90\": df[summary_cols].quantile(0.9),\n",
    "    \"max\": df[summary_cols].max()\n",
    "}).round(2)\n",
    "summary"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "6a1d6ce1",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Explore how price and minimum nights vary across top neighborhoods.\n",
    "if neigh_col and price_col:\n",
    "    top_neigh = df[neigh_col].value_counts().head(15).index.tolist()\n",
    "    neigh_stats = (\n",
    "        df[df[neigh_col].isin(top_neigh)]\n",
    "        .groupby(neigh_col)\n",
    "        .agg(\n",
    "            listings=(\"id\", \"nunique\"),\n",
    "            price_median=(price_col, \"median\"),\n",
    "            price_mean=(price_col, \"mean\"),\n",
    "            min_nights_median=(minn_col, \"median\"),\n",
    "            min_nights_mean=(minn_col, \"mean\"),\n",
    "        )\n",
    "        .round(2)\n",
    "        .sort_values(\"price_median\", ascending=False)\n",
    "    )\n",
    "    neigh_stats.head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "5e37c9f7",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Compare median prices across room types.\n",
    "if room_col and price_col:\n",
    "    room_stats = (\n",
    "        df.groupby(room_col)\n",
    "        .agg(\n",
    "            listings=(\"id\", \"nunique\"),\n",
    "            price_median=(price_col, \"median\"),\n",
    "            price_mean=(price_col, \"mean\"),\n",
    "            min_nights_median=(minn_col, \"median\"),\n",
    "            availability365_mean=(avail365_col, \"mean\"),\n",
    "        )\n",
    "        .round(2)\n",
    "        .sort_values(\"price_median\", ascending=False)\n",
    "    )\n",
    "    room_stats"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "9b4b88c8",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Examine correlations among numeric features.\n",
    "num_cols = [c for c in [price_col, minn_col, avail365_col, host_port_col, rpm_col, revcount_col] if c in df.columns]\n",
    "if num_cols:\n",
    "    corr = df[num_cols].corr()\n",
    "    corr"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "59712238",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Identify neighborhoods with a higher proportion of multi-listing hosts.\n",
    "if multi_col and neigh_col:\n",
    "    neigh_multi = (\n",
    "        df.groupby(neigh_col)\n",
    "        .agg(\n",
    "            listings=(\"id\", \"nunique\"),\n",
    "            multi_hosts=(multi_col, \"mean\")\n",
    "        )\n",
    "        .assign(multi_hosts_pct=lambda x: (x[\"multi_hosts\"] * 100).round(2))\n",
    "        .sort_values(\"multi_hosts_pct\", ascending=False)\n",
    "        .head(15)\n",
    "    )\n",
    "    neigh_multi"
   ]
  },
