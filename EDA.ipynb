   "metadata": {},
   "outputs": [],
   "source": [
    "# Load the cleaned dataset\n",
    "FIG_DIR = Path(\"figures\")\n",
    "FIG_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "fp = Path("data/cleaned_chicago_data.csv")\n",
    "df = pd.read_csv(fp, low_memory=False)"
   ]
