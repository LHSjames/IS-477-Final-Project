   ],
   "source": [
    "# Check dataset dimensions, column types, and missing value percentages.\n",
    "date_candidates = [\"host_since\", \"first_review_date\", \"last_review_date\", \"last_review\"]\n",
    "for col in date_candidates:\n",
    "    if col in df.columns:\n",
    "        df[col] = pd.to_datetime(df[col], errors=\"coerce\")\n",
    "\n",
    "print(\"Rows, Columns:\", df.shape)\n",
    "print(\"\\nColumn Types:\\n\", df.dtypes)\n",
    "print(\"\\nMissing Values (%):\\n\", (df.isna().mean() * 100).round(2))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "7a21ab94",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Detect important columns for analysis.\n",
    "colmap = {c.lower(): c for c in df.columns}\n",
    "\n",
    "neigh_col = colmap.get(\"neighbourhood_clean\", colmap.get(\"neighbourhood\"))\n",
    "price_col = colmap.get(\"price\", None)\n",
    "minn_col = colmap.get(\"minimum_nights\", None)\n",
    "avail365_col = colmap.get(\"availability_365\", None)\n",
    "rpm_col = colmap.get(\"reviews_per_month_proxy\", None)\n",
    "revcount_col = colmap.get(\"review_count_total\", None)\n",
    "room_col = colmap.get(\"room_type\", None)\n",
    "host_port_col = colmap.get(\"host_portfolio_size\", None)\n",
    "multi_col = colmap.get(\"is_multi_listing_host\", None)\n"
   ]
  },
