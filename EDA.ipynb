   "source": [
    "# Generate and save figures for the report.\n",
    "plt.style.use('seaborn-v0_8-whitegrid')\n",
    "\n",
    "# Price distribution\n",
    "if price_col in df.columns:\n",
    "    plt.figure(figsize=(8,5))\n",
    "    df[price_col].dropna().plot(kind=\"hist\", bins=60, color=\"skyblue\")\n",
    "    plt.title(\"Distribution of Listing Prices\")\n",
    "    plt.xlabel(\"Price\")\n",
    "    plt.ylabel(\"Count\")\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(FIG_DIR / \"fig_price_hist.png\")\n",
    "\n",
    "# Median price by room type\n",
    "if room_col and price_col:\n",
    "    price_by_room = df.groupby(room_col)[price_col].median().sort_values(ascending=False)\n",
    "    plt.figure(figsize=(7,4))\n",
    "    price_by_room.plot(kind=\"bar\", color=\"lightcoral\")\n",
    "    plt.title(\"Median Price by Room Type\")\n",
    "    plt.xlabel(\"Room Type\")\n",
    "    plt.ylabel(\"Median Price\")\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(FIG_DIR / \"fig_price_by_room.png\")\n",
    "\n",
    "plt.show()\n",
    "print(\"EDA completed. Figures saved to:\", FIG_DIR)"
   ]
  },
